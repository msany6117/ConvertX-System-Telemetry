# ====================================================================
# ConvertX Server & AI Configuration
# Copy this file to .env and provide your respective credentials.
# On Vercel: Add GEMINI_API_KEY in Project Settings > Environment Variables.
# Real keys must NEVER be committed to Git.
# ====================================================================

# 1. AI Provider Credentials
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"
DEEPSEEK_API_KEY="YOUR_DEEPSEEK_API_KEY_HERE"
GROQ_API_KEY="YOUR_GROQ_API_KEY_HERE"

# 2. AI Router Priority & Models
AI_PROVIDER_PRIORITY="gemini,deepseek,groq"
GEMINI_MODEL="gemini-3.8-flash"
DEEPSEEK_MODEL="deepseek-chat"
GROQ_MODEL="openai/gpt-oss-120b"

# 3. Operational Policies
AI_TIMEOUT_MS=25000
AI_MAX_RETRIES=1
AI_COOLDOWN_SECONDS=60

# 4. User Quotas & Cost Control
FREE_AI_REQUESTS_PER_DAY=60
FREE_MAX_INPUT_LENGTH=10000
PRO_AI_REQUESTS_PER_DAY=500
PRO_MAX_INPUT_LENGTH=100000

# 5. Core Platform Settings
PORT=3000
MAX_UPLOAD_MB=500
MAX_SIMULTANEOUS_FILES=10
JOB_TIMEOUT_SECONDS=300
FILE_RETENTION_MINUTES=60
